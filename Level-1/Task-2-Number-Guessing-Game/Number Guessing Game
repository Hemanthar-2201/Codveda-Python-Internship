import random

print("Welcome to Number Gussing Game!")
print("Description: the game is simple there are 3 levels 'Easy'(1-10), 'Moderate'(1-50), 'Hard'(1-100) \nIn each levels the system will choose a number and you will be given with different number of lives to guess the number\n Here you go all the best!! ")

#user enter which level they want Easy or Moderate or Hard
level = int(input("Enter which level you prefer \n1. Easy(1-10)\n2. Moderate(1-50)\n3. Hard(1-100)\n"))

#level 1 Easy(1-10)
if level == 1:
    guess_number = random.randint(1, 10)
    max_attempt = 5

    for i in range (1, max_attempt + 1):
        print("Attempt:", i + 1, "of", max_attempt)
        user_guess = int(input("Enter you guess: "))

        if user_guess == guess_number:
            print("Congraluations! you guessed the correct number.\nYou guessed it in ", i," attempt")
            break

        elif user_guess < guess_number:
            print(user_guess, " is Too low!!")

        else:
            print(user_guess, " is Too high!!")

        print()


        remaining_attempts = max_attempt - i

        if remaining_attempts > 0:
            print("Attempts remaining: ", remaining_attempts)

        else:
            print("\nGame over!!\nYou used all your attempts\nThe correct number was : ", guess_number)



